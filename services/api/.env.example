APP_NAME=always-beautiful-api
APP_VERSION=0.1.0
APP_ENV=development

SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30

DOCS_ENABLED=true
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./always_beautiful.db

AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

ADMIN_OWNER_EMAIL=owner@example.com
ADMIN_OWNER_USERNAME=owner-admin
ADMIN_OWNER_PASSWORD=change-me

ADMIN_TECHNICAL_EMAIL=tech@example.com
ADMIN_TECHNICAL_USERNAME=tech-admin
ADMIN_TECHNICAL_PASSWORD=change-me

SHIPIT_EMAIL=
SHIPIT_ACCESS_TOKEN=
SHIPIT_BASE_URL=https://api.shipit.cl/v
SHIPIT_MODE=simulated